#!/usr/bin/env bash

set -euo pipefail

cd "${BASH_SOURCE[0]%/*}/../.."
export DATABASE_URL="${DATABASE_URL:-postgres://pgqueue:pgqueue@localhost:${PGQUEUE_POSTGRES_PORT:-3532}/pgqueue}"

docker compose up -d --wait postgres

# Use the library's migration path so databases created by 0.1.0 receive its legacy schema repair too.
cargo run --locked --quiet --bin pgqueue-migrate
